# Template only, NEVER put real keys in this file, it is committed to git.
# Copy to .env (gitignored) and fill that in instead.

# Rime TTS (https://app.rime.ai/tokens)
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=            # run scripts/pick_voice.py, then set (e.g. nadi)

# Qdrant Cloud (https://cloud.qdrant.io -> cluster)
# URL = the cluster endpoint shown on the cluster page, plus :6333
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# LLM brains: Gemini primary (https://aistudio.google.com/apikey),
# Groq fallback (https://console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=

DEFAULT_USER_ID=aditya

# --- Google Calendar + Gmail (optional, capability-gated) ---
# These are NOT env vars: connection happens via OAuth files in the repo root.
# See README -> "Connect Google": create a Desktop-app OAuth client in a new
# Google Cloud project (Calendar + Gmail APIs enabled, audience External in
# Testing mode, yourself added as test user, scopes auth/calendar and
# auth/gmail.modify), download the client JSON as credentials.json, restart.
# First run pops a one-time browser consent; token.json is created after it.
# Both files are gitignored and never leave this machine. Without them EIRA
# runs fully, with calendar/email tools absent.
